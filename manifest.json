{
  "manifest_version": 3,
  "name": "OoFind - Visual Search for Odoo",
  "short_name": "OoFind",
  "version": "0.3.0",
  "description": "Visual filters with live counts, a domain workbench and 'why isn't this record here?' explanations for Odoo 16+.",
  "icons": {
    "16": "src/icons/icon-16.png",
    "32": "src/icons/icon-32.png",
    "48": "src/icons/icon-48.png",
    "128": "src/icons/icon-128.png"
  },
  "action": {
    "default_title": "OoFind: toggle the search panel (Alt+Shift+F)",
    "default_icon": {
      "16": "src/icons/icon-16.png",
      "32": "src/icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/background.js"]
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Toggle the OoFind panel"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "oofind@oofind.app",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
